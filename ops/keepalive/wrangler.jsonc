{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "spoken-backend-keepalive",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // UTC: every five minutes, 24/7. This intentionally uses the full Render
    // free allowance (~744h in a 31-day month against a 750h workspace cap).
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BACKEND_HEALTH_URL": "https://spoken-backend-sg.onrender.com/api/ready"
  },
  "observability": {
    "enabled": true
  }
}
